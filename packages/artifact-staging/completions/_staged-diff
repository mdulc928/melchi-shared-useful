#compdef staged-diff

_staged-diff() {
    local -a commands files apply_options session_options
    local line

    if (( CURRENT == 2 )); then
        commands=(
            'all:Open side-by-side diffs for every pending file'
            'apply:Copy staged file(s) into the workspace'
            'clean:Delete staged files for this session'
            'rename:Rename a staged file and record the mapping'
            '--help:Show how to use this command'
            '-h:Show how to use this command'
            '--sessions:List staging sessions for this repository'
            '--all-repos:List staging sessions across repositories'
            '--install-completion:Link zsh tab completion into ~/.zfunc'
        )
        while IFS= read -r line; do
            [[ -n "$line" ]] && commands+=("$line")
        done < <(staged-diff --complete 2>/dev/null)
        _describe -t commands 'staged-diff' commands
    elif (( CURRENT == 3 )) && [[ "${words[2]}" == "apply" ]]; then
        apply_options=(
            '-f:Specify staged file to apply'
            '--file:Specify staged file to apply'
            'all:Apply all staged files and remove obsolete files'
        )
        while IFS= read -r line; do
            [[ -n "$line" ]] && files+=("$line")
        done < <(staged-diff --list 2>/dev/null)
        _describe -t options 'apply options' apply_options
        _describe -t files 'staged files' files
    elif (( CURRENT == 4 )) && [[ "${words[2]}" == "apply" ]] && [[ "${words[3]}" == "-f" || "${words[3]}" == "--file" || "${words[3]}" == "--f" ]]; then
        while IFS= read -r line; do
            [[ -n "$line" ]] && files+=("$line")
        done < <(staged-diff --list 2>/dev/null)
        _describe -t files 'staged files' files
    elif (( CURRENT == 3 )) && [[ "${words[2]}" == "rename" ]]; then
        while IFS= read -r line; do
            [[ -n "$line" ]] && files+=("$line")
        done < <(staged-diff --list 2>/dev/null)
        _describe -t files 'staged files' files
    elif (( CURRENT == 4 )) && [[ "${words[2]}" == "rename" ]]; then
        _files
    elif (( CURRENT == 3 )) && [[ "${words[2]}" == "-s" || "${words[2]}" == "--session" ]]; then
        while IFS= read -r line; do
            [[ -n "$line" ]] && session_options+=("$line")
        done < <(staged-diff --complete-sessions 2>/dev/null)
        _describe -t sessions 'available sessions' session_options
    fi
}

_staged-diff "$@"
